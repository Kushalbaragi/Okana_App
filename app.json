{
  "expo": {
    "name": "Okana",
    "slug": "okana",
    "scheme": "okana",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "bundleIdentifier": "com.kushalbaragi.okana",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kushalbaragi.okana",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidSoftInputMode",
      [
        "expo-image-picker",
        {
          "photosPermission": "Okana uses your photo library so you can set a profile picture."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae7a978-9c7a-4aa1-8757-e07f03a0239c"
      }
    },
    "owner": "kushalbaragi10s-team"
  }
}

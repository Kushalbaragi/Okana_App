{
  "expo": {
    "name": "Okana",
    "slug": "okana",
    "scheme": "okana",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.kushalbaragi.okana",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.kushalbaragi.okana"
        ]
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kushalbaragi.okana",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withAndroidSoftInputMode",
      [
        "expo-image-picker",
        {
          "photosPermission": "Okana uses your photo library so you can set a profile picture."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native/expo",
      "expo-localization",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OkanaDailyChart",
              "label": "This month",
              "description": "This month's spending, day by day, against last month.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ae7a978-9c7a-4aa1-8757-e07f03a0239c"
      }
    },
    "owner": "kushalbaragi10s-team"
  }
}

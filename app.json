{
  "expo": {
    "name": "Okana",
    "slug": "okana-mobile",
    "scheme": "okana",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kushalbaragi.okana"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kushalbaragi.okana"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withAndroidSoftInputMode",
      [
        "expo-image-picker",
        {
          "photosPermission": "Okana uses your photo library so you can set a profile picture."
        }
      ],
      "expo-document-picker"
    ]
  }
}
